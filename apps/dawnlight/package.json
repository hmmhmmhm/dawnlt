{
  "name": "dawnlight",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/dawnlight.umd.cjs",
  "module": "./dist/dawnlight.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dawnlight.js",
      "require": "./dist/dawnlight.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode app",
    "build:app": "vite build --mode app",
    "build:lib": "tsc --noEmit && vite build --mode lib",
    "build:release": "pnpm run build:lib && pnpm run build:app",
    "preview": "vite preview --mode app",
    "test": "jest",
    "lint": "biome lint .",
    "start": "vite build --mode app && vite preview --mode app",
    "assets:optimize": "node ./scripts/optimize-gltf-assets.mjs",
    "assets:meshy": "node ./scripts/meshy-generate.mjs",
    "assets:meshy:publish": "node ./scripts/publish-meshy-assets.mjs"
  },
  "packageManager": "pnpm@10.33.4",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "ios-haptics": "^0.1.4",
    "react-icons": "^5.5.0",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@webgpu/types": "^0.1.66",
    "esbuild": "0.28.0",
    "jest": "^30.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^4.3.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vite-plugin-dts": "^5.0.1"
  }
}
